# Expo SDK 54 pins react/react-dom to 19.1.0 (see AGENTS.md — the SDK is not
# negotiable, Expo Go only supports this one). @clerk/react asks for a peer of
# react-dom "^18.0.0 || ~19.1.4 || ~19.2.3 || ~19.3.0-0", and 19.1.0 satisfies
# none of those ranges.
#
# npm 11 shrugs and warns. npm 10 — which is what the EAS build image runs —
# tries to auto-install a react-dom (and react, and scheduler) that satisfies
# the range, finds no lockfile entry for it, and fails `npm ci` outright. That
# is a build that cannot succeed no matter how many times it is retried.
#
# Letting it "resolve" would be worse than the failure: a second copy of React
# in a React Native bundle breaks every hook at runtime, and it would do so
# only in the standalone build.
#
# This makes both npm versions behave identically and keeps exactly one React.
# The only thing it drops is Clerk's optional Solana/web3 peer tree (~45
# packages), which this app never touches — auth is email/password and
# Google/Apple SSO.
legacy-peer-deps=true
