{
  "name": "spendowl-server",
  "private": true,
  "type": "module",
  "description": "SpendOwl API — Hono + Postgres, per-user data behind Clerk auth.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env.local src/index.ts",
    "start": "node --env-file-if-exists=../.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "scrape:gnb": "node --env-file-if-exists=../.env.local src/scraper/scrape.ts gnb",
    "scrape:sudameris": "node --env-file-if-exists=../.env.local src/scraper/scrape.ts sudameris",
    "scrape:universitaria": "node --env-file-if-exists=../.env.local src/scraper/scrape.ts universitaria",
    "import": "node --env-file-if-exists=../.env.local src/scraper/import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/backend": "^3.13.2",
    "@hono/node-server": "^2.0.12",
    "cheerio": "^1.2.0",
    "hono": "^4.12.32",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "typescript": "~5.9.2"
  }
}
